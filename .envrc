eval "$(devbox generate direnv --print-envrc)"

export ENVNAME=rust
export TOP_HEAD=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)

unset GITHUB_TOKEN
export PATH=$PATH:$TOP_HEAD:$TOP_HEAD/target/debug:$TOP_HEAD/target/release

# Add devbox and system libraries for GUI support
export LD_LIBRARY_PATH=$TOP_HEAD/.devbox/nix/profile/default/lib:${LD_LIBRARY_PATH}
export PKG_CONFIG_PATH=$TOP_HEAD/.devbox/nix/profile/default/lib/pkgconfig:${PKG_CONFIG_PATH}

export_alias _b "cd $TOP_HEAD && make build; cd -"
export_alias _x "cd $TOP_HEAD && make reconfig; cd -"
export_alias _c "cd $TOP_HEAD && make config; cd -"
export_alias _r "cd $TOP_HEAD && make run; cd -"
export_alias _t "cd $TOP_HEAD && make test; cd -"
